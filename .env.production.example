# Production configuration (docs/28 §W9).
#
#   cp .env.production.example .env   and fill in every REQUIRED value.
#
# deploy.sh refuses to start if a required key is missing or still holds a
# development default, because the defaults live in this repository and are
# therefore the ones most likely to reach production by accident.

ENVIRONMENT=production
LOG_LEVEL=INFO

# ---------- REQUIRED: secrets ----------
# Salt for hashing IPs in the audit log. Rotating it makes historical addresses
# permanently unlinkable, which is the point of salting them.
#   openssl rand -hex 32
AUDIT_IP_SALT=

POSTGRES_USER=visiovox
POSTGRES_PASSWORD=
POSTGRES_DB=visiovox

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=visiovox-media
S3_FORCE_PATH_STYLE=true

# ---------- REQUIRED: public URLs ----------
# One hostname for app, API and media. Keeping them on one origin means no
# CORS configuration, one certificate, and one entry in Firebase's authorized
# domains. deploy.sh refuses while these still say visiovox.example.com.
#
# Inlined into the web bundle at BUILD time, so changing any of them needs a
# rebuild, not a restart.
PUBLIC_API_URL=https://visiovox.example.com
PUBLIC_MEDIA_BASE_URL=https://visiovox.example.com/media
# CORS allows exactly this origin.
NEXT_PUBLIC_APP_URL=https://visiovox.example.com

# ---------- REQUIRED: Firebase identity (ADR-0016) ----------
# Console -> Project settings -> General -> Your apps -> Web. These are
# compiled into the bundle and are public by design: they identify the
# project, they do not authorise anything.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The project whose ID tokens the API accepts. A token signed for any other
# project must be rejected, so this is the audience check, not a label.
FIREBASE_PROJECT_ID=
# Console -> Project settings -> Service accounts -> Generate new private key.
# Save it at secrets/firebase-service-account.json (gitignored); compose mounts
# that directory read-only. THIS one is a real secret - it can mint a token for
# any user in the project.
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json
# Ask Firebase on every request whether the session was revoked. Costs a round
# trip; without it "sign out everywhere" is advisory for up to an hour.
FIREBASE_CHECK_REVOKED=true

# ---------- Tunnel ----------
# Cloudflare Zero Trust -> Networks -> Tunnels -> create a tunnel, route it at
# the hostname above, and paste the token it gives back. Only needed with
# --tunnel. The tunnel dials out, so there is no inbound port to open and no
# static IP to buy.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- Storage ----------
MEDIA_ROOT=/srv/media
MEDIA_WORK_DIR=/srv/media/work
# On, because this is the machine whose `df /` reports the vhdx's virtual
# maximum rather than real free space.
REQUIRE_DEDICATED_MEDIA_VOLUME=true
DISK_RESERVED_BYTES=21474836480
UPLOAD_PEAK_MULTIPLIER=2.5
MAX_UPLOAD_BYTES=53687091200

# ---------- Pipeline ----------
PIPELINE_MODE=real
# c3, not c2-v2: c2-v2 scores +11.43 dB on VoxCeleb2 but -1.61 dB on the
# product condition, i.e. worse than doing nothing. See config.py.
# Step-stamped rather than best.pt: the configuration should state which
# model is serving, and best.pt is overwritten by the next training run.
# Byte-identical to best.pt today; the name is the point.
EXTRACTOR_CHECKPOINT=/home/dmin/runs/c3/best-step27000-10.92dB.pt
TORCH_DEVICE=cuda
MEDIA_SANDBOX_IMAGE=visiovox/media-sandbox:1
SPEAKER_EMBEDDER_DIR=/home/dmin/models/ecapa
# pyannote diarization is gated. Without it S2a degrades to VAD only and the
# pipeline falls back to single-speaker handling.
HF_TOKEN=

# ---------- Limits ----------
MAX_DURATION_SECONDS=3600
QUOTA_UPLOADS_PER_DAY=20
QUOTA_MEDIA_SECONDS_PER_MONTH=36000
QUOTA_GPU_SECONDS_PER_MONTH=36000
QUOTA_CONCURRENT_JOBS=2

# ---------- Security ----------
# Behind the tunnel every request arrives from cloudflared, so the real client
# address has to be read from the header it sets. Set this ONLY when such a
# proxy is genuinely in front: with nothing overwriting the header, any caller
# can mint a fresh identity per request and per-IP limiting stops meaning
# anything.
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
RATE_LIMIT_ENABLED=true
# Redis down allows requests rather than taking the API down with the cache.
RATE_LIMIT_FAIL_OPEN=true
