# Web image (docs/28 §W9).
#
# NEXT_PUBLIC_API_URL is baked in at BUILD time, not read at start-up. Next
# inlines NEXT_PUBLIC_* into the client bundle, so a container started with a
# different value keeps talking to whatever it was compiled against — which
# looks exactly like a CORS or connection bug and is neither. It is a build arg
# for that reason, and the compose file passes it.
FROM node:22-slim AS builder

RUN corepack enable
WORKDIR /build

# Dependency layer first, so a source change does not re-resolve the workspace.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY packages/ts-client/package.json packages/ts-client/
COPY packages/contracts/package.json packages/contracts/
RUN pnpm install --frozen-lockfile

COPY tsconfig.base.json tsconfig.json eslint.config.mjs .prettierrc.json ./
COPY packages packages
COPY apps/web apps/web

ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

# Firebase web config (ADR-0016). Public by design - these identify the
# project, they do not authorise anything; the security is in the token
# signature. Inlined here for the same reason as the API URL: set them at
# start-up instead and the bundle ships with empty strings, so the login page
# reports Firebase as unconfigured with no way to fix it short of a rebuild.
ARG NEXT_PUBLIC_FIREBASE_API_KEY=
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID=
ARG NEXT_PUBLIC_FIREBASE_APP_ID=
ENV NEXT_PUBLIC_FIREBASE_API_KEY=${NEXT_PUBLIC_FIREBASE_API_KEY} \
    NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=${NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN} \
    NEXT_PUBLIC_FIREBASE_PROJECT_ID=${NEXT_PUBLIC_FIREBASE_PROJECT_ID} \
    NEXT_PUBLIC_FIREBASE_APP_ID=${NEXT_PUBLIC_FIREBASE_APP_ID}

RUN pnpm --filter @visiovox/ts-client build \
 && pnpm --filter @visiovox/web build


FROM node:22-slim AS runtime

RUN useradd --create-home --uid 10002 visiovox
WORKDIR /app

# Next's standalone output ships only the files actually reached, which is a
# fraction of node_modules.
COPY --from=builder --chown=visiovox:visiovox /build/apps/web/.next/standalone ./
COPY --from=builder --chown=visiovox:visiovox /build/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=visiovox:visiovox /build/apps/web/public ./apps/web/public

ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
USER visiovox
EXPOSE 3000

CMD ["node", "apps/web/server.js"]
